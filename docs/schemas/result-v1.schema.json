{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "engine", "scanId", "hosts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "type": "string" },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "confidence", "verdict"],
        "properties": {
          "verdict": { "enum": ["CONFIRMED_CANDIDATE", "CONFIRMED_NOT_VULNERABLE", "WEAK_SIGNAL_ONLY"] },
          "confidence": { "type": "number", "minimum": 0.05, "maximum": 0.95 }
        }
      }
    }
  }
}
