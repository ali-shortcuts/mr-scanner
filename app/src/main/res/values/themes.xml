<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MrScannerOmega" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/omega_primary</item>
        <item name="colorPrimaryDark">@color/omega_bg</item>
        <item name="colorAccent">@color/omega_primary</item>
        <item name="android:statusBarColor">@color/omega_bg</item>
        <item name="android:navigationBarColor">@color/omega_bg</item>
        <item name="android:windowBackground">@color/omega_bg</item>
        <item name="android:textColorPrimary">@color/omega_on_bg</item>
        <item name="android:textColorSecondary">@color/omega_muted</item>
        <item name="android:buttonStyle">@style/OmegaButton</item>
    </style>
    <style name="OmegaButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/omega_on_bg</item>
    </style>
    <style name="OmegaCard">
        <item name="android:background">@color/omega_surface</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="OmegaSectionTitle">
        <item name="android:textColor">@color/omega_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
